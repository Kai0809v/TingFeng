<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 沉浸式：状态栏区域透明，壁纸/背景直接透出。
         此处仅保留服务开关气泡动画的锚点（默认宽 0 不可见）。 -->
    <FrameLayout
        android:id="@+id/paopao_anchor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 气泡条：宽度由动画控制（0 → 90dp），默认不可见 -->
        <View
            android:id="@+id/status_bar"
            android:layout_width="0dp"
            android:layout_height="30dp"
            android:layout_marginTop="2dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_gradient_1" />
    </FrameLayout>

    <!-- 此容器有状态栏高度的 padding（代码中设置），
         关闭裁剪以允许 fragment 内容（顶栏）延伸进状态栏区域。
         ViewPager2 常驻三个 tab 页（工具/主页/设置，懒加载），
         Dock 点击切换，无 Navigation 导航栈。 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/main_pager"
        android:layout_width="0dp"
        android:layout_height="0dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        android:clipChildren="false"
        android:clipToPadding="false"/>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/floating_dock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
